{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tilawa-video-studio-website-staging",
  "main": "../../cloudflare-worker.js",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": "../../.open-next/assets", "binding": "ASSETS" },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "tilawa-video-studio-website-staging" }
  ],
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "REPLACE_WITH_ISOLATED_NEXT_CACHE" },
    { "binding": "VIDEO_STUDIO_ASSETS", "bucket_name": "REPLACE_WITH_ENV_ASSET_BUCKET" },
    { "binding": "VIDEO_STUDIO_PRIVATE", "bucket_name": "REPLACE_WITH_ENV_PRIVATE_BUCKET" }
  ],
  "d1_databases": [
    {
      "binding": "VIDEO_STUDIO_DB",
      "database_name": "REPLACE_WITH_ENV_DB_NAME",
      "database_id": "REPLACE_WITH_ENV_DB_UUID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": { "STUDIO_ENABLED": "0", "STUDIO_ORIGIN": "https://REPLACE_WITH_WEBSITE_ORIGIN" },
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
