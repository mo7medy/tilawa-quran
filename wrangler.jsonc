{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tilawa-quran",
  "account_id": "89bd9386a8a12ce65152900f5c72c72e",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "tilawa-quran" }],
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "tilawa-quran-cache" },
    { "binding": "VIDEO_STUDIO_BACKGROUNDS", "bucket_name": "tilawa-video-backgrounds" },
    { "binding": "VIDEO_STUDIO_ASSETS", "bucket_name": "tilawa-video-studio-assets" },
    { "binding": "VIDEO_STUDIO_PRIVATE", "bucket_name": "tilawa-video-studio-private" }
  ],
  "d1_databases": [
    {
      "binding": "VIDEO_STUDIO_DB",
      "database_name": "tilawa-video-studio",
      "database_id": "445290da-ffa6-44a3-bc16-1db2aecb6af6",
      "migrations_dir": "services/video-renderer/migrations"
    }
  ],
  "vars": {
    "STUDIO_ORIGIN": "https://tilawa-quran.muhammad5mdk.workers.dev",
    "STUDIO_ENABLED": "1"
  },
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true, "redact_query_string": true, "traces": { "enabled": true } }
}
