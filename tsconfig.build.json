{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler"
  },
  "include": [
    "next-env.d.ts",
    "global.d.ts",
    "module.d.ts",
    "redux-thunk.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "types/**/*.ts",
    "sentry*.ts",
    "open-next.config.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.stories.ts",
    "**/*.stories.tsx",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
