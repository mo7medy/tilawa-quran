{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tilawa-video-studio-staging",
  "account_id": "89bd9386a8a12ce65152900f5c72c72e",
  "main": "services/video-renderer/staging-worker.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "VIDEO_STUDIO_DB",
      "database_name": "tilawa-video-studio-staging",
      "database_id": "5bcb532b-b8e3-4f8a-9873-d31edcf2340b",
      "migrations_dir": "services/video-renderer/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "VIDEO_STUDIO_BACKGROUNDS", "bucket_name": "tilawa-video-backgrounds" },
    { "binding": "VIDEO_STUDIO_ASSETS", "bucket_name": "tilawa-video-studio-assets-staging" },
    { "binding": "VIDEO_STUDIO_PRIVATE", "bucket_name": "tilawa-video-studio-private-staging" }
  ],
  "vars": {
    "STUDIO_ENABLED": "0",
    "STUDIO_ORIGIN": "https://tilawa-video-studio-staging.muhammad5mdk.workers.dev",
    "QURAN_API_ENV": "production"
  },
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true, "redact_query_string": true, "traces": { "enabled": true } }
}
